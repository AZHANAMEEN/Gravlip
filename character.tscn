[sub_resource type="GDScript" id="GDScript_glpr6"]
script/source = "extends CharacterBody2D
@onready var tmr = $Timer
var contactime= 0.0
const SPEED = 300.0
var JUMP_VELOCITY = -400.0
var grav = 40000
var FMC = 3
var FRTC = false
var  resetime = 0.2
func _physics_process(delta: float) -> void:
	if not is_on_floor():
		velocity.y = grav*delta
	var supported := is_on_ceiling()
	if supported:
		contactime += 0.05
	if contactime >= resetime and not FRTC :
		FMC = 3
		FRTC = true
		contactime = 0
	else  :
		FRTC = false
	# Handle jump.
	if Input.is_action_just_pressed(\"ui_accept\") :
		if  is_on_ceiling() or is_on_floor():
			velocity.y = JUMP_VELOCITY
			JUMP_VELOCITY = -1*JUMP_VELOCITY
			grav = -1*grav
		elif FMC > 0 :
			velocity.y = JUMP_VELOCITY
			JUMP_VELOCITY = -1*JUMP_VELOCITY
			grav = -1*grav
			FMC = FMC - 1
	print(FMC,\"  \", FRTC,\"  \", contactime)
	
	if position.x >= 700 :
		velocity.x = 0
	else:
		velocity.x =70
	if position.x < 0 or position.y > 720 or position.y < 0 :
		get_tree().quit()
	move_and_slide()

		
	
"

